{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "template-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "templates"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "template_id",
          "profile",
          "version",
          "lifecycle",
          "capability",
          "template_ref",
          "schema_ref",
          "renderer_ref",
          "formats",
          "committee_authorized"
        ],
        "properties": {
          "template_id": {
            "type": "string",
            "minLength": 1
          },
          "profile": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "lifecycle": {
            "enum": [
              "candidate",
              "active",
              "deprecated"
            ]
          },
          "capability": {
            "enum": [
              "schema_only",
              "preview",
              "demo_only",
              "ready"
            ]
          },
          "template_ref": {
            "type": "string",
            "minLength": 1
          },
          "schema_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "renderer_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "formats": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "html",
                "pdf",
                "png",
                "docx",
                "slides"
              ]
            }
          },
          "committee_authorized": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
