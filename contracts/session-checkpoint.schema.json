{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "session-checkpoint.schema.json",
  "title": "Portable session checkpoint v0.1 — verified state is external",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "entity_id",
    "cutoff",
    "stage",
    "repo_sha",
    "run_context",
    "input_pins",
    "output_pins",
    "critical_claim_refs",
    "counterclaim_refs",
    "decisive_unknowns",
    "validations",
    "integrator",
    "gate",
    "next_action",
    "stop_condition"
  ],
  "properties": {
    "version": {
      "const": "0.1.0"
    },
    "entity_id": {
      "type": "string",
      "minLength": 1
    },
    "cutoff": {
      "type": "string",
      "format": "date"
    },
    "stage": {
      "enum": [
        "INTAKE",
        "RESEARCH",
        "MARKET_CONTEXT",
        "ANALYSIS",
        "OPPORTUNITIES",
        "RED_TEAM",
        "HITL_PENDING",
        "GO_DRAFT",
        "FROZEN",
        "RENDERED",
        "DONE"
      ]
    },
    "repo_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "run_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "input_pins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "output_pins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "depends_on"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "critical_claim_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "counterclaim_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decisive_unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN"
            ]
          },
          "receipt_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "integrator": {
      "type": "string",
      "minLength": 1
    },
    "gate": {
      "enum": [
        "OPEN",
        "HITL_PENDING",
        "APPROVED_REF_ONLY"
      ]
    },
    "human_decision_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "next_action": {
      "type": "string",
      "minLength": 4
    },
    "stop_condition": {
      "type": "string",
      "minLength": 4
    }
  }
}
