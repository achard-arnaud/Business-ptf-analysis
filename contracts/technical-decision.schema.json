{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_type": {
      "enum": [
        "rupture-adr",
        "debt-risk",
        "migration-tco",
        "ecosystem-impact",
        "bootstrap-dx",
        "run-readiness",
        "poc-verdict"
      ]
    },
    "criticality": {
      "enum": [
        "reversible",
        "material",
        "structural"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "layer": {
            "enum": [
              "source",
              "run",
              "runtime",
              "dependency",
              "adr",
              "test"
            ]
          }
        },
        "required": [
          "id",
          "ref",
          "sha256",
          "layer"
        ],
        "additionalProperties": false
      }
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "tradeoff": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "description",
          "tradeoff"
        ],
        "additionalProperties": false
      }
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "hypothesis": {
            "type": "string",
            "minLength": 1
          },
          "falsifier": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "hypothesis",
          "falsifier",
          "verification"
        ],
        "additionalProperties": false
      }
    },
    "sections": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "analysis": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "unknowns": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "analysis",
          "evidence_refs",
          "unknowns"
        ],
        "additionalProperties": false
      }
    },
    "measures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "observed",
              "estimated",
              "unknown"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reading": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "evidence_id": {
                    "type": "string"
                  },
                  "pointer": {
                    "type": "string",
                    "pattern": "^/"
                  }
                },
                "required": [
                  "evidence_id",
                  "pointer"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "id",
          "value",
          "unit",
          "status",
          "evidence_refs"
        ],
        "additionalProperties": false
      }
    },
    "guardrails": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "measure_id": {
            "type": "string",
            "minLength": 1
          },
          "operator": {
            "enum": [
              "<=",
              ">="
            ]
          },
          "threshold": {
            "type": "number"
          }
        },
        "required": [
          "measure_id",
          "operator",
          "threshold"
        ],
        "additionalProperties": false
      }
    },
    "decision": {
      "type": "object",
      "properties": {
        "option_id": {
          "type": "string",
          "minLength": 1
        },
        "verdict": {
          "enum": [
            "Adopt",
            "Trial",
            "Hold",
            "Kill",
            "proposed"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        },
        "rollback": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "option_id",
        "verdict",
        "reason",
        "next_action",
        "rollback"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "case_id",
    "decision_type",
    "criticality",
    "objective",
    "constraints",
    "owner",
    "evidence",
    "options",
    "assumptions",
    "sections",
    "measures",
    "guardrails",
    "decision"
  ],
  "additionalProperties": false
}
